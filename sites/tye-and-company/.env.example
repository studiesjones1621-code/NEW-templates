# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Server-side secrets (used by retell/setup.py and scripts/gen-images.py only)
RETELL_API_KEY=
GEMINI_API_KEY=
CAL_API_KEY=

# Browser-safe values used by the Retell website widget
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
NEXT_PUBLIC_RETELL_AGENT_ID=
# Optional: your production URL, for canonical/OG links (Vercel sets its own automatically)
NEXT_PUBLIC_SITE_URL=
